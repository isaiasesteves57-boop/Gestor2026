rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'cliente'
        && request.resource.data.status == 'pendente';
      allow update: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.plano == resource.data.plano
        && request.resource.data.data_inicio == resource.data.data_inicio
        && request.resource.data.data_vencimento == resource.data.data_vencimento);
      allow delete: if admin();
    }
    match /subscriptions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }
    match /jogosPublicados/{jogoId} {
      allow read: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ativo';
      allow create, update, delete: if admin();
    }
    match /mensagens/{mensagemId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /dados/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // ETAPA 4: Sala ao vivo — só admin e clientes com status "ativo" participam.
    match /salaAoVivo/{mensagemId} {
      allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ativo');
      allow create: if signedIn()
        && (admin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ativo')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 500;
      allow update: if false;
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
